# Telegram MTProto credentials from https://my.telegram.org (optional; without them the web-preview source is used)
TG_API_ID=
TG_API_HASH=
# TG_CHANNEL=war_monitor
# SOURCE=web|telethon   (default: telethon if creds set, else web)
# POLL_SEC=10

# Regions that get alerts, as comma-separated KATOTTG oblast prefixes (UA80 = Kyiv city, UA32 = Kyiv oblast,
# UA12 = Dnipropetrovsk, UA23 = Zaporizhzhia, UA48 = Mykolaiv, UA51 = Odesa, UA59 = Sumy, UA63 = Kharkiv,
# UA74 = Chernihiv). Everything else is greyed out as "coming soon". ENABLED_LABEL is the name shown in the panel.
ENABLED_OBLASTS=UA80,UA32,UA12,UA23,UA48,UA51,UA59,UA63,UA74
ENABLED_LABEL=Київ і 8 областей
