# Telegram MTProto credentials from https://my.telegram.org (optional; without them the web-preview source is used)
TG_API_ID=
TG_API_HASH=
# TG_CHANNEL=war_monitor
# SOURCE=web|telethon   (default: telethon if creds set, else web)
# POLL_SEC=10

# Regions shown to users as KATOTTG oblast prefixes, comma-separated (UA80 = Kyiv city). Everything else is "coming soon".
ENABLED_OBLASTS=UA80
ENABLED_LABEL=Київ
